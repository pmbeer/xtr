<article class="continue-card">
	<a class="continue-card__link" href="{full-link}" title="{title}">
		<div class="continue-card__thumb">
			[image-1]<img src="{image-1}" alt="{title}" loading="lazy">[/image-1]
			[not-image-1]<div class="continue-card__placeholder"></div>[/not-image-1]
			<div class="continue-card__overlay"><span class="continue-card__play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></div>
			<div class="continue-card__progress" style="width:45%"></div>
		</div>
		<h3 class="continue-card__title">{title limit="40"}</h3>
		<p class="continue-card__episode">[xfgiven_season]Сезон {xfvalue_season} · [/xfgiven_season]Серия {xfvalue_episode}</p>
	</a>
</article>
