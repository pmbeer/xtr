<a class="episode-card" href="{full-link}">
	<div class="episode-card__thumb">
		[image-1]<img src="{image-1}" alt="{title}" loading="lazy">[/image-1]
		<span class="episode-card__play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
	</div>
	<span class="episode-card__label">{title}</span>
</a>
