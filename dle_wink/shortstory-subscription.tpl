<div class="plan-card">
	<div class="plan-card__head">
		<h3 class="plan-card__name">{title}</h3>
		<span class="plan-card__badge">{short-story limit="30"}</span>
	</div>
	<div class="plan-card__stats">
		<span class="plan-card__stat"><strong>{views}</strong> ТВ-каналов</span>
		<span class="plan-card__stat"><strong>{rating}</strong> Фильмов и сериалов</span>
	</div>
	<p class="plan-card__desc">{full-story}</p>
	<a href="{full-link}" class="btn btn--primary btn--block">{link-category}</a>
</div>
