# Токен Telegram-бота (@BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Входящий вебхук Bitrix24:
# Разработчикам → Другое → Входящий вебхук
# Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ID пользователя Bitrix24, по которому строится аналитика
# Узнать: user.current или профиль → ID в URL
BITRIX_USER_ID=1

# Список Telegram user id через запятую (пусто = доступ всем)
ALLOWED_TELEGRAM_IDS=

# Период по умолчанию (дней), если в запросе не указан
DEFAULT_PERIOD_DAYS=30

# Каталог для временных отчётов
REPORTS_DIR=./data/reports

# Демо-режим без реального Bitrix24 (true/false)
DEMO_MODE=false