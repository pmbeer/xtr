# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Кто имеет право пользоваться ботом (telegram user id через запятую).
# Пустое значение = доступ разрешён всем, кто знает бота (не рекомендуется).
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Bitrix24
# ---------------------------------------------------------------------------
# Входящий вебхук облачного Битрикс24.
# Создаётся в портале: Разработчикам -> Другое -> Входящий вебхук.
# Нужны права: task (задачи), imopenlines (открытые линии), user, crm.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ID пользователя Битрикс24, по которому считается статистика по умолчанию.
# Если не задан — берётся владелец вебхука (метод profile).
BITRIX_DEFAULT_USER_ID=

# Часовой пояс, в котором считаются периоды («сегодня», «за месяц» и т.п.)
TIMEZONE=Europe/Moscow

# Ограничение частоты обращений к REST Битрикс24 (запросов в секунду).
BITRIX_RATE_LIMIT=2

# Таймаут одного запроса к REST, секунды
BITRIX_TIMEOUT=30

# Ограничение на количество выгружаемых записей одного типа (защита от
# выгрузки десятков тысяч задач по слишком широкому периоду).
BITRIX_MAX_RECORDS=5000

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------
# Файл SQLite для привязок «telegram-пользователь -> пользователь Битрикс24»
DATABASE_PATH=./data/bot.sqlite3

# Каталог для сгенерированных файлов отчётов
REPORTS_DIR=./data/reports

# Формат отчёта по умолчанию: xlsx | csv | json
DEFAULT_REPORT_FORMAT=xlsx

LOG_LEVEL=INFO
