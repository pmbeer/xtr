<div class="profile-page">
	<div class="profile-card">
		<div class="profile-card__header">
			<div class="profile-card__avatar">{foto}</div>
			<div class="profile-card__info">
				<h1 class="profile-card__name">{login}</h1>
				<span class="profile-card__group">{group}</span>
				<span class="profile-card__reg">На сайте с {registration}</span>
			</div>
		</div>
		<div class="profile-card__stats">
			<div class="stat"><span class="stat__value">{news-num}</span><span class="stat__label">Публикаций</span></div>
			<div class="stat"><span class="stat__value">{comm-num}</span><span class="stat__label">Комментариев</span></div>
			<div class="stat"><span class="stat__value">{rate}</span><span class="stat__label">Рейтинг</span></div>
		</div>
		<div class="profile-card__body">
			{edituser}
			{info}
		</div>
	</div>
</div>
