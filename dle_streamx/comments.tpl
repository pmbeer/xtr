<div class="comment" id="comment-{id}">
	<div class="comment__avatar">{foto}</div>
	<div class="comment__body">
		<div class="comment__header">
			<span class="comment__author">{author}</span>
			<span class="comment__date">{date}</span>
		</div>
		<div class="comment__text">{comment}</div>
		<div class="comment__actions">
			[rating-plus]<span class="comment__rating">+{rating}</span>[/rating-plus]
			{reply-link}
		</div>
	</div>
</div>
