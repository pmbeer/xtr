<div class="sx-comment" id="{comment-id}">
	<div class="sx-comment__avatar">
		<img src="{foto}" alt="{login}" width="48" height="48">
	</div>
	<div class="sx-comment__body">
		<div class="sx-comment__head">
			<span class="sx-comment__author">{author}</span>
			<span class="sx-comment__date">{date}</span>
			[rating-type-3]<span class="sx-comment__rate">{rating}</span>[/rating-type-3]
		</div>
		<div class="sx-comment__text">{comment}</div>
		<div class="sx-comment__tools">
			[reply]<button type="button">Ответить</button>[/reply]
			[com-edit]<button type="button">Изменить</button>[/com-edit]
			[com-del]<button type="button">Удалить</button>[/com-del]
			[complaint]<button type="button">Жалоба</button>[/complaint]
		</div>
		[signature]<div class="sx-comment__sign">{signature}</div>[/signature]
	</div>
</div>
