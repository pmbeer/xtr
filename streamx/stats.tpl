<div class="sx-container sx-page">
	<div class="sx-panel">
		<h1 class="sx-panel__title">Статистика сайта</h1>
		<ul class="sx-facts">
			<li><span>Публикаций</span><b>{news_num}</b></li>
			<li><span>Комментариев</span><b>{comm_num}</b></li>
			<li><span>Пользователей</span><b>{user_num}</b></li>
			<li><span>За сутки</span><b>{news_day} / {comm_day} / {user_day}</b></li>
			<li><span>За неделю</span><b>{news_week} / {comm_week} / {user_week}</b></li>
			<li><span>За месяц</span><b>{news_month} / {comm_month} / {user_month}</b></li>
		</ul>
		<div class="sx-stats__extra">
			<p>Размер БД: {datenbank}</p>
			<p>Последняя публикация: {news}</p>
			<p>Последний комментарий: {comment}</p>
			<p>Последний пользователь: {user}</p>
		</div>
	</div>
</div>
