<article class="sx-hero__slide">
	<div class="sx-hero__media">
		[xfgiven_backdrop]<img src="[xfvalue_backdrop]" alt="{title}">[/xfgiven_backdrop]
		[xfnotgiven_backdrop]
			[xfgiven_poster]<img src="[xfvalue_poster]" alt="{title}">[/xfgiven_poster]
			[xfnotgiven_poster]
				[image-1]<img src="{image-1}" alt="{title}">[/image-1]
			[/xfnotgiven_poster]
		[/xfnotgiven_backdrop]
		<div class="sx-hero__shade"></div>
	</div>
	<div class="sx-container sx-hero__content">
		<h2 class="sx-hero__title"><a href="{full-link}">{title}</a></h2>
		<p class="sx-hero__text">
			[xfgiven_slogan][xfvalue_slogan][/xfgiven_slogan]
			[xfnotgiven_slogan]{short-story limit="140"}[/xfnotgiven_slogan]
		</p>
		<div class="sx-hero__meta">
			[xfgiven_year]<span>[xfvalue_year]</span>[/xfgiven_year]
			[xfgiven_genre]<span>[xfvalue_genre]</span>[/xfgiven_genre]
			[xfgiven_kp]<span class="sx-rate sx-rate--kp">КП [xfvalue_kp]</span>[/xfgiven_kp]
			[xfgiven_quality]<span class="sx-chip">[xfvalue_quality]</span>[/xfgiven_quality]
		</div>
		<div class="sx-hero__actions">
			<a class="sx-btn sx-btn--primary" href="{full-link}">Смотреть</a>
			[xfgiven_trailer]<a class="sx-btn sx-btn--ghost" href="[xfvalue_trailer]" target="_blank" rel="noopener">Трейлер</a>[/xfgiven_trailer]
		</div>
	</div>
</article>
