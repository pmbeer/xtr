# Входящий вебхук Bitrix24:
# Приложения → Разработчикам → Другое → Входящий вебхук
# Права: task, user, imopenlines, im, crm (по необходимости)
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ID пользователя, чью активность анализируем (по умолчанию — владелец вебхука)
BITRIX24_USER_ID=

# Период отчёта по умолчанию (дни)
REPORT_DAYS=7

# SQLite для накопления событий открытых линий
DATABASE_PATH=./data/analytics.db

# Хост/порт веб-дашборда и приёмника событий
HOST=0.0.0.0
PORT=8080
