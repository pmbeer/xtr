[Unit]
Description=Bitrix24 to Telegram and MAX relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bitrix-relay
EnvironmentFile=/opt/bitrix-relay/.env
ExecStart=/opt/bitrix-relay/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
