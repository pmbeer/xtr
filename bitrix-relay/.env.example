# === Битрикс24 ===
# URL входящего вебхука (со слэшем в конце)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ID и токен бота (получите после регистрации через scripts/register_bitrix_bot.sh)
BITRIX_BOT_ID=0
BITRIX_BOT_TOKEN=change_me_bot_secret_token

# ID чата-источника в Битрикс24 (число, например 123)
BITRIX_SOURCE_CHAT_ID=0

# application_token из первого webhook-события (auth.application_token)
# Можно оставить пустым на этапе теста — тогда проверка отключена
BITRIX_APP_TOKEN=

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Публичный: @channel_name  |  Приватный: -1001234567890
TELEGRAM_CHANNEL_ID=@your_channel

# === MAX ===
MAX_BOT_TOKEN=your_max_bot_token
MAX_CHANNEL_CHAT_ID=1234567890

# === Сервер ===
HOST=127.0.0.1
PORT=8000
# Префикс подписи к постам: "Имя Фамилия:\nтекст"
MESSAGE_AUTHOR_PREFIX=true

# Пауза между отправками в MAX (сек), лимит ~2 msg/sec
MAX_SEND_DELAY=0.6

# SQLite для защиты от дублей
DEDUP_DB_PATH=/opt/bitrix-relay/data/dedup.db
