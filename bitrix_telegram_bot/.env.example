# Токен Telegram-бота (получить от @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# URL входящего вебхука Bitrix24 (Настройки → Разработчикам → Входящий вебхук)
# Пример: https://your-domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_key/

# ID пользователя Bitrix24 для анализа (ваш ID в системе)
BITRIX_USER_ID=1

# Список Telegram user ID, которым разрешён доступ к боту (через запятую)
ALLOWED_TELEGRAM_IDS=123456789
