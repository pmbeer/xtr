TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
# Telegram user IDs allowed to request reports, comma-separated.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Incoming webhook: https://example.bitrix24.ru/rest/1/secret/
BITRIX24_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/replace_with_webhook_secret/
# Leave empty to use the user associated with the webhook.
BITRIX24_USER_ID=
BITRIX24_TIMEOUT_SECONDS=30

# New Bitrix24 Open Lines analytics methods. Override if your portal uses aliases.
BITRIX24_OPENLINES_STATS_METHOD=imopenlines.v2.Stat.get

REPORT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
