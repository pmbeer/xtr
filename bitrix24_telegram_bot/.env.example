# Токен Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# URL входящего вебхука Bitrix24 (Разработчикам -> Другое -> Входящий вебхук).
# Нужны права доступа: task (Задачи), crm (CRM), imopenlines (Открытые линии), user (Пользователи).
# Формат: https://ваш-портал.bitrix24.ru/rest/<ID пользователя>/<код вебхука>/
BITRIX_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/abc123def456/

# ID вашего пользователя в Bitrix24, по которому считается статистика
BITRIX_USER_ID=1

# Список Telegram ID пользователей, которым разрешено пользоваться ботом (через запятую).
# Оставьте пустым, чтобы разрешить всем (не рекомендуется).
ALLOWED_TELEGRAM_IDS=

# Часовой пояс портала (для границ периодов "сегодня", "неделя" и т.п.)
TIMEZONE=Europe/Moscow
