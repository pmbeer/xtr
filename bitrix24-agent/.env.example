# URL входящего вебхука Битрикс24.
# Как получить: Битрикс24 -> Разработчикам -> Другое -> Входящий вебхук.
# Обязательно выберите права (scope) как минимум: task, crm, im, user.
# Формат: https://ваш-портал.bitrix24.ru/rest/<user_id>/<webhook_code>/
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxxxxxxxxxx/

# ID пользователя Битрикс24, чью продуктивность нужно анализировать.
# Если не указан, агент попробует определить текущего пользователя вебхука через user.current.
BITRIX24_USER_ID=

# Часовой пояс для расчёта границ периодов (today/week/month), например +03:00.
# Если не задан, используется локальный часовой пояс машины, на которой запущен агент.
BITRIX24_TZ_OFFSET=+03:00

# (опционально) Отправлять готовый отчёт себе в Битрикс24 личным уведомлением/сообщением.
BITRIX24_NOTIFY=false
