# ─── Обязательное ────────────────────────────────────────────────────────────
# Входящий вебхук портала.
# Битрикс24 → Разработчикам → Другое → Входящий вебхук.
# Права (скоупы): task, imopenlines, crm, telephony, user.
B24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ─── Необязательное ──────────────────────────────────────────────────────────
# Чей отчёт собирать. По умолчанию — владелец вебхука.
# Чужую статистику покажет только при наличии прав (обычно у руководителя).
#B24_USER_ID=1

# Часовой пояс портала — от него зависят границы суток в отчёте.
B24_TIMEZONE=Europe/Moscow

# Интенсивность запросов, запросов в секунду.
# Облако Битрикс24 разрешает 2 (на тарифе Enterprise — 5).
B24_RATE_LIMIT=2

# Таймаут HTTP-запроса в секундах и число повторов при ошибке лимита.
B24_TIMEOUT=30
B24_MAX_RETRIES=4

# Предохранители выгрузки: сколько записей максимум разбирать детально.
# Счётчики остаются точными, по выборке считаются только средние значения.
B24_MAX_TASKS=2000
B24_MAX_SESSIONS=2000

# База истории снимков для команды `history`.
#B24_STORAGE_PATH=~/.bitrix24-agent/snapshots.sqlite3

# ─── Вопросы на естественном языке (команда `ask`) ───────────────────────────
# Любой сервис, совместимый с Chat Completions API. Без этих настроек
# остальные команды работают как обычно.
#B24_LLM_BASE_URL=https://api.openai.com/v1
#B24_LLM_API_KEY=sk-...
#B24_LLM_MODEL=gpt-4o-mini
