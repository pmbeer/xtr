# URL входящего вебхука Битрикс24.
# Создаётся на портале: Разработчикам -> Другое -> Входящий вебхук.
# Нужные права (scope): Задачи (task), Открытые линии (imopenlines), Пользователи (user).
BITRIX24_WEBHOOK_URL=https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# Необязательно: ID пользователя, по которому строить отчёт.
# Если не задан, отчёт строится по владельцу вебхука.
# BITRIX24_USER_ID=1
