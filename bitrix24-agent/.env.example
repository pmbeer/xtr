# URL входящего вебхука Bitrix24 (без завершающего слэша)
# Пример: https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
BITRIX24_WEBHOOK_URL=https://yourcompany.bitrix24.ru/rest/1/your_webhook_token

# ID пользователя для анализа (ваш ID в Bitrix24)
# Можно узнать через метод user.current
BITRIX24_USER_ID=1

# Период анализа (опционально, по умолчанию — текущий месяц)
# Формат: YYYY-MM-DD
ANALYTICS_DATE_FROM=2026-08-01
ANALYTICS_DATE_TO=2026-08-31
