# === Telegram ===
# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenChangeMe

# Список Telegram user_id, которым разрешено пользоваться ботом (через запятую).
# Узнать свой id можно, написав боту @userinfobot
# Если оставить пустым — бот будет отвечать всем (не рекомендуется).
TELEGRAM_ALLOWED_USER_IDS=123456789

# === Bitrix24 ===
# Входящий вебхук вашего портала Битрикс24.
# Applications > Developer resources > Other > Incoming webhook.
# Нужны права (scope): task, crm, imopenlines, user
# Пример: https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ID пользователя Битрикс24, чью статистику показывать по умолчанию
# (обычно это ID пользователя, создавшего вебхук). Узнать можно через
# метод user.current или в профиле пользователя в Битрикс24.
BITRIX_DEFAULT_USER_ID=1

# Необязательно: сопоставление Telegram user_id -> Bitrix24 user_id в формате JSON,
# если ботом пользуется несколько человек и каждому нужна своя статистика.
# Пример: {"123456789": 1, "987654321": 5}
TELEGRAM_TO_BITRIX_USER_MAP={}

# Часовой пояс портала Битрикс24 (используется для расчёта периодов "сегодня",
# "неделя" и т.п.). Список зон: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BITRIX_TIMEZONE=Europe/Moscow

# Каталог для временных файлов отчётов
REPORTS_DIR=./data/reports

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
